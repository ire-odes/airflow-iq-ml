# Copy this file to service/.env and fill in the two values below.
# service/.env is gitignored -- never commit real values.

# Settings -> Data API in the Supabase dashboard (same project the app uses).
SUPABASE_URL=https://hniplnaohvcbtmelatnz.supabase.co

# Settings -> API keys -> service_role (NOT the anon key the app uses).
# This key bypasses Row Level Security -- it belongs only here, never in
# the mobile/web app, never committed.
SUPABASE_SERVICE_ROLE_KEY=
